PORT=4100
WEB_ORIGIN=http://localhost:5173
WA_DRIVER=mock
SESSION_DIR=.wa-sessions

# Resend email alerts.
# RESEND_FROM must use a sender/domain verified in Resend, for example:
# RESEND_FROM="Wapi <notify@yourdomain.com>"
RESEND_API_KEY=
RESEND_FROM="Wapi <noreply@notify.proyek.org>"
ALERT_EMAIL=
ALERT_COOLDOWN_MS=900000
